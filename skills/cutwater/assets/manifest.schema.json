{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/YourAKShaw/CutWater/main/skills/cutwater/assets/manifest.schema.json",
  "title": "cutwater setup manifest",
  "description": "Records what cutwater applied and verified in a repository. Written last, only after verification. Schema v1 and v2; v2 adds the GitHub Project.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skillVersion", "createdAt", "updatedAt", "repo", "defaultBranch", "choices", "applied"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "enum": [1, 2] },
    "skillVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
    "defaultBranch": { "type": "string", "minLength": 1 },
    "choices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "stack", "license", "ci", "dependencyBot", "wiki", "ruleset"],
      "properties": {
        "visibility": { "enum": ["private", "public", "internal"] },
        "stack": { "enum": ["node-ts", "node", "python", "go", "generic"] },
        "license": { "enum": ["MIT", "Apache-2.0", "GPL-3.0", "none"] },
        "ci": { "type": "array", "uniqueItems": true, "items": { "enum": ["lint", "test", "build", "release"] } },
        "dependencyBot": { "enum": ["dependabot", "renovate", "none"] },
        "wiki": { "type": "boolean" },
        "projectsBoard": { "type": ["string", "null"], "description": "Deprecated (v1). v2 uses choices.project." },
        "ruleset": { "type": "boolean" },
        "coderabbit": { "enum": ["off", "quiet", "chill", "assertive"] },
        "emojiLabels": { "type": "boolean" },
        "acceptOrgDefaults": { "type": "boolean" },
        "copyrightYear": { "type": "string", "pattern": "^\\d{4}$" },
        "copyrightHolder": { "type": "string" },
        "maintainer": { "type": "string" },
        "securityContact": { "type": "string" },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "mode", "title", "fields", "seed"],
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "enum": ["create", "adopt"] },
            "title": { "type": "string" },
            "fields": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "seed": { "type": "boolean" }
          }
        }
      }
    },
    "applied": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "labels"],
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["template", "sha256"],
            "properties": { "template": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
          }
        },
        "labels": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "rulesetId": { "type": ["integer", "null"] }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "description": "The Project as applied. Ids are written only after live verification; item ids are never stored.",
      "required": ["owner", "ownerType", "number", "id", "title", "url", "linked", "adopted", "fields"],
      "properties": {
        "owner": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "ownerType": { "enum": ["user", "organization"] },
        "number": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://github\\.com/" },
        "linked": { "type": "boolean" },
        "adopted": { "type": "boolean" },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "priority"],
          "properties": {
            "status": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "options"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "options": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["todo", "inProgress", "inReview", "blocked", "done"],
                  "properties": {
                    "todo": { "type": "string", "minLength": 1 },
                    "inProgress": { "type": "string", "minLength": 1 },
                    "inReview": { "type": "string", "minLength": 1 },
                    "blocked": { "type": "string", "minLength": 1 },
                    "done": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "priority": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "options"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "options": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["p0", "p1", "p2", "p3"],
                  "properties": {
                    "p0": { "type": "string", "minLength": 1 },
                    "p1": { "type": "string", "minLength": 1 },
                    "p2": { "type": "string", "minLength": 1 },
                    "p3": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [{ "if": { "properties": { "schemaVersion": { "const": 1 } }}, "then": { "not": { "required": ["project"] }, "properties": { "choices": { "required": ["projectsBoard"], "not": { "required": ["project"] } }} }}]
}
