{
  "name": "cutwater",
  "version": "0.1.0",
  "private": true,
  "description": "Development tooling for the cutwater Agent Skill: a GitHub-native, issue-first SDLC workflow driven through gh and git.",
  "license": "Apache-2.0",
  "author": "Ayush Kumar Shaw",
  "homepage": "https://github.com/YourAKShaw/CutWater#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YourAKShaw/CutWater.git"
  },
  "bugs": {
    "url": "https://github.com/YourAKShaw/CutWater/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "validate": "node scripts/validate-skill.ts",
    "build": "node scripts/build.ts",
    "build:check": "node scripts/build.ts --check",
    "test": "node --test test/*.test.ts test/integration/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check . && tsc -p tsconfig.json",
    "format": "prettier --write .",
    "evals:check": "node scripts/evals.ts check",
    "license:check": "node scripts/license-headers.ts",
    "check": "npm run validate && npm run build:check && npm run evals:check && npm run license:check && npm test && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
